    "/api/invoices/{invoiceId}/pdf": {
      "post": {
        "tags": [
          "InvoicePdf"
        ],
        "summary": "Starts (or returns the already in-flight) PDF generation job for an invoice.",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PdfJobDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "get": {
        "tags": [
          "InvoicePdf"
        ],
        "summary": "Returns the status of the most recent PDF generation job for an invoice.",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PdfJobDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - no PDF job has been started for this invoice"
          }
        }
      }
    },
    "/api/invoices/{invoiceId}/pdf/download": {
      "get": {
        "tags": [
          "InvoicePdf"
        ],
        "summary": "Downloads the rendered PDF once the job's status is Printed.",
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - no completed PDF job for this invoice"
          }
        }
      }
    },
